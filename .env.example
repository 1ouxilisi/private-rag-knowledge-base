# ===== Ollama connection =====
OLLAMA_BASE=http://localhost:11434
CHAT_MODEL=qwen3:8b
EMBED_MODEL=bge-m3

# ===== RAG behavior =====
TOP_K=5
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TEMPERATURE=0.2

# ===== Paths (relative to project root) =====
INPUT_DIR=inputs
DATA_DIR=data

# ===== App =====
APP_PORT=8501

# Copy this file to ".env" and adjust per client environment.
# Do not commit the real .env if it contains internal hostnames or credentials.
